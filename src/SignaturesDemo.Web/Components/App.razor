   our thin wrapper before the closing body tag so that Blazor's circuit can JS-interop
   into them as soon as it boots. *@
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="SignaturesDemo.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <title>SignaturesDemo · Firma electrónica con AutoFirma</title>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="lib/afirma/autoscript.js"></script>
    <script src="js/autofirma-integration.js"></script>
</body>

</html>
